# Copy to .env — docker compose and the python settings both read this file.
# *_PORT values are the HOST-side ports; change them if another stack already uses them.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=homepedia
POSTGRES_USER=homepedia
POSTGRES_PASSWORD=change-me

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=homepedia
MONGO_USER=homepedia
MONGO_PASSWORD=change-me

SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=homepedia

DATA_LAKE_ROOT=./data

# ingestion scope: JSON lists (pydantic-settings)
DEPARTMENTS=["33","31","44"]
DVF_YEARS=[2023,2024]
DPE_SINCE=2024-01-01
LOG_LEVEL=INFO

# host ports for web UIs
SPARK_MASTER_PORT=7077
SPARK_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
JUPYTER_PORT=8888
STREAMLIT_PORT=8501
